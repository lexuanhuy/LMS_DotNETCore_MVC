@model IEnumerable<LMS_DotNETCore_MVC.Models.Course>

@{
    ViewData["Title"] = "Danh sách khóa học";

    var currentFilter = ViewBag.CurrentFilter as string ?? "";
    var pageNumber = ViewBag.CurrentPage as int? ?? 1; // Khớp với tên ViewBag.CurrentPage bên Controller
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="container py-4">
    <!-- Search & Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <form class="row g-2" method="get" asp-action="Index">
                <div class="col-md-6 col-sm-8 col-12">
                    <div class="input-group">
                        <input type="search"
                               name="searchString"
                               class="form-control"
                               placeholder="Tìm tên khóa học..."
                               value="@currentFilter" />
                        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Courses")">Xóa bộ lọc</a>
                    </div>
                </div>
                <div class="col-md-6 col-sm-4 d-flex justify-content-md-end mt-2 mt-md-0">
                    <!-- Place for future filters (category, level, sort...) -->
                </div>
            </form>
        </div>
    </div>

    <!-- Course Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var course in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                        {
                            <img src="@course.ImageUrl" class="card-img-top" alt="@course.Title" style="object-fit:cover;height:180px;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                <span class="text-muted">Không có ảnh</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold mb-2" style="min-height:3.6rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @course.Title
                            </h5>

                            <p class="card-text text-muted mb-3" style="flex:0 0 auto;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                                @course.Description
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                @if (@course.Price > 0)
                                {
                                    <div class="text-primary fw-semibold fs-5">
                                        @course.Price
                                    </div>
                                }
                                else
                                {
                                    <div class="text-primary fw-semibold fs-5">
                                        Miễn phí
                                    </div>
                                }

                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber - 1)" asp-route-searchString="@currentFilter">Trang trước</a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == pageNumber ? "active" : "")" aria-current="@(i == pageNumber ? "page" : null)">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@currentFilter">@i</a>
                        </li>
                    }

                    <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber + 1)" asp-route-searchString="@currentFilter">Trang tiếp</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <h4 class="card-title mb-3">Không tìm thấy khóa học nào phù hợp</h4>
                        <p class="text-muted mb-4">Thử thay đổi từ khóa tìm kiếm hoặc xóa bộ lọc để xem tất cả khóa học.</p>
                        <a class="btn btn-primary" href="@Url.Action("Index", "Courses")">Quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>