@using LMS_DotNETCore_MVC.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav d-flex align-items-center gap-2">
	@if (SignInManager.IsSignedIn(User))
	{
		var currentUser = await UserManager.GetUserAsync(User);
		var avatarUrl = string.IsNullOrEmpty(currentUser?.AvatarPath)
			? Url.Content("~/images/course-thumbnail.png")
			: Url.Content(currentUser.AvatarPath);

		var isAdmin = currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Admin");
		var isInstructor = currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Instructor");
		var isStudent = currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Student");

		<li class="nav-item dropdown">
			<a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark bg-light px-3 py-1 rounded-pill border"
			   href="#"
			   id="userDropdown"
			   role="button"
			   data-bs-toggle="dropdown"
			   aria-expanded="false">
				<span class="fw-semibold small">@(currentUser?.FullName ?? "Học viên")</span>
				<img id="avatarPreview" src="@avatarUrl" alt="Avatar"
					 class="rounded-circle border"
					 style="width:28px;height:28px;object-fit:cover;"
					 onerror="this.src='/images/course-thumbnail.png';">
			</a>

			<ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 mt-2" aria-labelledby="userDropdown">
				<li>
					<a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
						<i class="bi bi-person-gear me-2 text-muted"></i> Quản lý tài khoản
					</a>
				</li>
				@if (isAdmin)
				{
					<li>
						<a class="dropdown-item py-2 fw-semibold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
							<i class="bi bi-speedometer2 me-2"></i> Trang Admin
						</a>
					</li>
				}
				@if (isInstructor)
				{
					<li>
						<a class="dropdown-item py-2 fw-semibold text-success" asp-area="Instructor" asp-controller="Dashboard" asp-action="Index">
							<i class="bi bi-easel me-2"></i> Kênh Giảng viên
						</a>
					</li>
				}
				@if (isStudent)
				{
					<li>
						<a class="dropdown-item py-2" asp-controller="Enrollments" asp-action="MyCourses">
							<i class="bi bi-journal-bookmark me-2 text-muted"></i> Khóa học của tôi
						</a>
					</li>
				}
				<li><hr class="dropdown-divider" /></li>
				<li>
					<form class="m-0" asp-area="Identity" asp-page="/Account/Logout" method="post" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
						<button type="submit" class="dropdown-item py-2 text-danger">
							<i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
						</button>
					</form>
				</li>
			</ul>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="btn btn-sm btn-outline-secondary rounded-pill px-3" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
		</li>
		<li class="nav-item">
			<a class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
		</li>
	}
</ul>
