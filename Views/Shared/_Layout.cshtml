<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS Online Learning Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LMS_DotNETCore_MVC.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded-3 px-2 py-1 fs-5">🎓</span>
                    <span>LMS</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-2">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-dark px-3 rounded-pill" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-dark px-3 rounded-pill" asp-area="" asp-controller="Courses" asp-action="Index">Tất cả Khóa học</a>
                        </li>
                        @if (User.IsInRole(LMS_DotNETCore_MVC.Models.SD.Role_Student))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-dark px-3 rounded-pill" asp-area="" asp-controller="Enrollments" asp-action="MyCourses">
                                    <i class="bi bi-journal-bookmark me-1 text-primary"></i> Khóa học của tôi
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-auto text-muted">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-primary">LMS Platform</span> &copy; 2026 - Tất cả quyền được bảo lưu.
            </div>
            <div class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small">Chính sách bảo mật</a>
                <a href="#" class="text-muted text-decoration-none small">Điều khoản sử dụng</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
