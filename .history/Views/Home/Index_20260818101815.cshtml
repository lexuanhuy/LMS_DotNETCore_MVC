@model IEnumerable<LMS_DotNETCore_MVC.Models.Course>
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Section -->
<section class="bg-primary text-white py-5 px-2 rounded-2" style="background: linear-gradient(135deg,#0d6efd 0%, #6610f2 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold">Học tập nâng tầm sự nghiệp.</h1>
                <p class="lead mb-4">Khám phá hàng trăm khóa học chất lượng cao từ giảng viên uy tín. Học theo nhịp của bạn, nhận chứng chỉ và phát triển kỹ năng thực tế.</p>
                <a class="btn btn-light btn-lg shadow-sm" href="/Courses" role="button">Khám phá ngay</a>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <img src="~/images/course-thumbnail.png" alt="Learning illustration" class="img-fluid rounded shadow-lg">
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 mb-0">Khóa học nổi bật</h2>
            <a asp-controller="Courses" asp-action="Index" class="text-decoration-none">Xem tất cả &raquo;</a>
        </div>

        <div class="row">
            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@course.ImageUrl" class="card-img-top" alt="Khoá học 1">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-1">@course.Title</h5>
                            <p class="text-muted mb-2 small">Giảng viên: @course.Instructor.FullName</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                @if (@course.Price > 0)
                                {
                                    <span class="fw-semibold text-primary">₫@course.Price</span>
                                }
                                else
                                {
                                    <div class="fw-semibold text-primary">Miễn phí</div>
                                }
                                
                                <a href="/Courses/Details/1" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
