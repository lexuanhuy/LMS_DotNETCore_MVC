@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Dashboard
            </h1>

            <p class="text-muted mb-0">
                Tổng quan hoạt động của hệ thống LMS
            </p>
        </div>

        <div class="text-muted">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Now.ToString("dd/MM/yyyy")
        </div>

    </div>


    <!-- STATISTICS -->
    <div class="row g-4 mb-4">

        <!-- COURSES -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Tổng khóa học
                            </p>

                            <h2 class="fw-bold mb-0">
                                24
                            </h2>

                        </div>

                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-book-fill fs-4"></i>
                        </div>

                    </div>

                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        12% so với tháng trước
                    </div>

                </div>

            </div>

        </div>


        <!-- STUDENTS -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Học viên
                            </p>

                            <h2 class="fw-bold mb-0">
                                1,248
                            </h2>

                        </div>

                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>

                    </div>

                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        8.5% so với tháng trước
                    </div>

                </div>

            </div>

        </div>


        <!-- INSTRUCTORS -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Giảng viên
                            </p>

                            <h2 class="fw-bold mb-0">
                                36
                            </h2>

                        </div>

                        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                            <i class="bi bi-person-workspace fs-4"></i>
                        </div>

                    </div>

                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        5.2% so với tháng trước
                    </div>

                </div>

            </div>

        </div>


        <!-- REVENUE -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Doanh thu
                            </p>

                            <h2 class="fw-bold mb-0">
                                48.6M
                            </h2>

                        </div>

                        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>

                    </div>

                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        15.8% so với tháng trước
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- CONTENT -->
    <div class="row g-4">


        <!-- COURSE OVERVIEW -->
        <div class="col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Tổng quan khóa học
                            </h5>

                            <p class="text-muted small mb-0">
                                Thống kê khóa học trong hệ thống
                            </p>

                        </div>

                        <a asp-area="Admin"
                           asp-controller="Courses"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm">

                            Xem khóa học

                            <i class="bi bi-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>


                <div class="card-body p-4">

                    <!-- PROGRESS 1 -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Lập trình Web
                            </span>

                            <strong>
                                80%
                            </strong>

                        </div>

                        <div class="progress" style="height:8px;">

                            <div class="progress-bar"
                                 style="width:80%;">
                            </div>

                        </div>

                    </div>


                    <!-- PROGRESS 2 -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Lập trình C#
                            </span>

                            <strong>
                                65%
                            </strong>

                        </div>

                        <div class="progress" style="height:8px;">

                            <div class="progress-bar bg-success"
                                 style="width:65%;">
                            </div>

                        </div>

                    </div>


                    <!-- PROGRESS 3 -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                JavaScript
                            </span>

                            <strong>
                                55%
                            </strong>

                        </div>

                        <div class="progress" style="height:8px;">

                            <div class="progress-bar bg-warning"
                                 style="width:55%;">
                            </div>

                        </div>

                    </div>


                    <!-- PROGRESS 4 -->

                    <div>

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Database
                            </span>

                            <strong>
                                40%
                            </strong>

                        </div>

                        <div class="progress" style="height:8px;">

                            <div class="progress-bar bg-danger"
                                 style="width:40%;">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- QUICK ACTION -->
        <div class="col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-1">
                        Thao tác nhanh
                    </h5>

                    <p class="text-muted small mb-0">
                        Quản lý hệ thống
                    </p>

                </div>


                <div class="card-body p-4">

                    <div class="d-grid gap-3">

                        <a asp-area="Admin"
                           asp-controller="Courses"
                           asp-action="Create"
                           class="btn btn-primary text-start p-3">

                            <i class="bi bi-plus-circle me-2"></i>

                            Thêm khóa học

                        </a>


                        <a asp-area="Admin"
                           asp-controller="Courses"
                           asp-action="Index"
                           class="btn btn-outline-primary text-start p-3">

                            <i class="bi bi-book me-2"></i>

                            Quản lý khóa học

                        </a>


                        <a href="#"
                           class="btn btn-outline-secondary text-start p-3">

                            <i class="bi bi-people me-2"></i>

                            Quản lý học viên

                        </a>


                        <a href="#"
                           class="btn btn-outline-secondary text-start p-3">

                            <i class="bi bi-person-workspace me-2"></i>

                            Quản lý giảng viên

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- RECENT COURSES -->

        <div class="col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Khóa học mới nhất
                            </h5>

                            <p class="text-muted small mb-0">
                                Các khóa học mới được thêm
                            </p>

                        </div>

                        <a asp-area="Admin"
                           asp-controller="Courses"
                           asp-action="Index"
                           class="text-decoration-none">

                            Xem tất cả

                        </a>

                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Khóa học
                                </th>

                                <th>
                                    Giảng viên
                                </th>

                                <th>
                                    Giá
                                </th>

                                <th>
                                    Trạng thái
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <tr>

                                <td>

                                    <strong>
                                        Lập trình C# cơ bản
                                    </strong>

                                </td>

                                <td>
                                    Nguyễn Văn A
                                </td>

                                <td>
                                    499.000 ₫
                                </td>

                                <td>

                                    <span class="badge bg-success">
                                        Hoạt động
                                    </span>

                                </td>

                            </tr>


                            <tr>

                                <td>

                                    <strong>
                                        JavaScript cơ bản
                                    </strong>

                                </td>

                                <td>
                                    Trần Văn B
                                </td>

                                <td>
                                    399.000 ₫
                                </td>

                                <td>

                                    <span class="badge bg-success">
                                        Hoạt động
                                    </span>

                                </td>

                            </tr>


                            <tr>

                                <td>

                                    <strong>
                                        SQL Server
                                    </strong>

                                </td>

                                <td>
                                    Lê Văn C
                                </td>

                                <td>
                                    Miễn phí
                                </td>

                                <td>

                                    <span class="badge bg-warning text-dark">
                                        Chờ duyệt
                                    </span>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- ACTIVITY -->

        <div class="col-xl-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-1">
                        Hoạt động gần đây
                    </h5>

                    <p class="text-muted small mb-0">
                        Hoạt động mới nhất
                    </p>

                </div>


                <div class="card-body p-4">


                    <div class="d-flex gap-3 mb-4">

                        <div class="text-primary">
                            <i class="bi bi-person-plus-fill fs-4"></i>
                        </div>

                        <div>

                            <strong class="d-block">
                                Học viên mới
                            </strong>

                            <span class="text-muted small">
                                Có học viên mới đăng ký
                            </span>

                            <small class="text-muted d-block mt-1">
                                5 phút trước
                            </small>

                        </div>

                    </div>


                    <div class="d-flex gap-3 mb-4">

                        <div class="text-success">
                            <i class="bi bi-cart-check-fill fs-4"></i>
                        </div>

                        <div>

                            <strong class="d-block">
                                Đăng ký khóa học
                            </strong>

                            <span class="text-muted small">
                                Một học viên vừa đăng ký
                            </span>

                            <small class="text-muted d-block mt-1">
                                18 phút trước
                            </small>

                        </div>

                    </div>


                    <div class="d-flex gap-3 mb-4">

                        <div class="text-warning">
                            <i class="bi bi-book-fill fs-4"></i>
                        </div>

                        <div>

                            <strong class="d-block">
                                Khóa học mới
                            </strong>

                            <span class="text-muted small">
                                Khóa học mới được tạo
                            </span>

                            <small class="text-muted d-block mt-1">
                                1 giờ trước
                            </small>

                        </div>

                    </div>


                    <div class="d-flex gap-3">

                        <div class="text-danger">
                            <i class="bi bi-star-fill fs-4"></i>
                        </div>

                        <div>

                            <strong class="d-block">
                                Đánh giá mới
                            </strong>

                            <span class="text-muted small">
                                Học viên vừa đánh giá khóa học
                            </span>

                            <small class="text-muted d-block mt-1">
                                2 giờ trước
                            </small>

                        </div>

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>