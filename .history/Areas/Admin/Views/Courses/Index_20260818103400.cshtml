@model IEnumerable<LMS_DotNETCore_MVC.Models.Course>

@{
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Quản lý khóa học
            </h2>

            <p class="text-muted mb-0">
                Quản lý danh sách khóa học trên hệ thống
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Courses"
           asp-action="Create"
           class="btn btn-primary">

            + Thêm khóa học

        </a>

    </div>


    <!-- Statistics -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Tổng khóa học
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.Count()
                            </h3>
                        </div>

                        <div class="fs-1">
                            📚
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Khóa học miễn phí
                            </p>

                            <h3 class="fw-bold mb-0 text-success">
                                @Model.Count(c => c.Price == 0)
                            </h3>
                        </div>

                        <div class="fs-1">
                            🎁
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Khóa học trả phí
                            </p>

                            <h3 class="fw-bold mb-0 text-primary">
                                @Model.Count(c => c.Price > 0)
                            </h3>
                        </div>

                        <div class="fs-1">
                            💰
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Course table -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Danh sách khóa học
                </h5>

                <input type="text"
                       id="searchCourse"
                       class="form-control"
                       placeholder="Tìm kiếm khóa học..."
                       style="max-width:300px;" />

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:70px;">
                            ID
                        </th>

                        <th style="width:100px;">
                            Hình ảnh
                        </th>

                        <th>
                            Tên khóa học
                        </th>

                        <th>
                            Giảng viên
                        </th>

                        <th>
                            Giá
                        </th>

                        <th class="text-center">
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <tbody id="courseTable">

                    @foreach (var course in Model)
                    {
                        <tr>

                            <td>
                                @course.Id
                            </td>


                            <td>

                                @if (!string.IsNullOrEmpty(course.ImageUrl))
                                {
                                    <img src="@course.ImageUrl"
                                         style="width:70px;height:45px;object-fit:cover;border-radius:8px;"
                                         alt="@course.Title" />
                                }
                                else
                                {
                                    <div class="bg-light text-center"
                                         style="width:70px;height:45px;border-radius:8px;">
                                        📚
                                    </div>
                                }

                            </td>


                            <td>

                                <div class="fw-semibold">
                                    @course.Title
                                </div>

                            </td>


                            <td>

                                @if (course.Instructor != null)
                                {
                                    @course.Instructor.FullName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa có
                                    </span>
                                }

                            </td>


                            <td>

                                @if (course.Price > 0)
                                {
                                    <span class="fw-semibold text-primary">
                                        @course.Price ₫
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Miễn phí
                                    </span>
                                }

                            </td>


                            <td class="text-center">

                                <div class="btn-group">

                                    <a asp-area="Admin"
                                       asp-controller="Courses"
                                       asp-action="Details"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Xem
                                    </a>


                                    <a asp-area="Admin"
                                       asp-controller="Courses"
                                       asp-action="Edit"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>


                                    <a asp-area="Admin"
                                       asp-controller="Courses"
                                       asp-action="Delete"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Xóa
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    document.getElementById("searchCourse")
        .addEventListener("keyup", function () {

            const keyword = this.value.toLowerCase();

            const rows = document.querySelectorAll(
                "#courseTable tr"
            );

            rows.forEach(function (row) {

                const text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(keyword) ? "" : "none";

            });

        });

</script>