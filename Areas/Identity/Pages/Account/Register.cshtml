@page
@model RegisterModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<style>

    .register-page {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: linear-gradient(135deg, #f5f7ff 0%, #eef2ff 50%, #f8fafc 100%);
    }

    .register-wrapper {
        width: 100%;
        max-width: 1050px;
        display: grid;
        grid-template-columns: 42% 58%;
        background: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(30, 41, 59, 0.12);
    }

    /* =========================
       LEFT
    ========================= */

    .register-intro {
        position: relative;
        padding: 55px 45px;
        background: linear-gradient(145deg, #4f46e5, #6366f1, #7c3aed);
        color: white;
        overflow: hidden;
    }

    .register-intro::before {
        content: "";
        position: absolute;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        top: -80px;
        right: -80px;
    }

    .register-intro::after {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255,255,255,0.07);
        bottom: -60px;
        left: -50px;
    }

    .register-logo {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 60px;
    }

    .register-logo-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255,255,255,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .register-logo span {
        font-size: 23px;
        font-weight: 700;
        letter-spacing: .3px;
    }

    .register-intro-content {
        position: relative;
        z-index: 2;
    }

    .register-intro h2 {
        font-size: 34px;
        line-height: 1.25;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .register-intro p {
        font-size: 16px;
        line-height: 1.7;
        color: rgba(255,255,255,.85);
        margin-bottom: 35px;
    }

    .register-benefit {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 18px;
        font-size: 15px;
    }

    .register-benefit-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }


    /* =========================
       RIGHT
    ========================= */

    .register-form-section {
        padding: 45px 55px;
        background: #fff;
    }

    .register-header {
        margin-bottom: 30px;
    }

    .register-header h1 {
        font-size: 30px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
    }

    .register-header p {
        color: #6b7280;
        margin: 0;
        font-size: 15px;
    }


    /* =========================
       FORM
    ========================= */

    .register-field {
        margin-bottom: 18px;
    }

    .register-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .register-input-wrapper {
        position: relative;
    }

    .register-input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 17px;
        z-index: 2;
    }

    .register-input,
    .register-select {
        width: 100%;
        height: 50px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #f9fafb;
        padding: 0 15px 0 45px;
        font-size: 14px;
        color: #111827;
        transition: all .2s ease;
        outline: none;
    }

    .register-select {
        padding-left: 45px;
        appearance: auto;
    }

    .register-input:focus,
    .register-select:focus {
        background: #fff;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99,102,241,.1);
    }

    .register-input::placeholder {
        color: #9ca3af;
    }

    .register-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #dc2626;
    }


    /* =========================
       VALIDATION
    ========================= */

    .register-validation {
        border-radius: 10px;
        padding: 12px 15px;
        margin-bottom: 18px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13px;
    }


    /* =========================
       BUTTON
    ========================= */

    .register-button {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
        box-shadow: 0 8px 20px rgba(79,70,229,.22);
    }

    .register-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 25px rgba(79,70,229,.28);
    }

    .register-button:active {
        transform: translateY(0);
    }


    /* =========================
       LOGIN LINK
    ========================= */

    .register-login {
        text-align: center;
        margin-top: 22px;
        font-size: 14px;
        color: #6b7280;
    }

    .register-login a {
        color: #4f46e5;
        font-weight: 600;
        text-decoration: none;
    }

    .register-login a:hover {
        text-decoration: underline;
    }


    /* =========================
       EXTERNAL LOGIN
    ========================= */

    .external-login {
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid #e5e7eb;
    }

    .external-login-title {
        text-align: center;
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 15px;
    }

    .external-login button {
        width: 100%;
        height: 46px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 14px;
        font-weight: 500;
        transition: .2s;
    }

    .external-login button:hover {
        background: #f9fafb;
        border-color: #c7d2fe;
    }


    /* =========================
       RESPONSIVE
    ========================= */

    @@media (max-width: 850px) {

        .register-wrapper {
            grid-template-columns: 1fr;
            max-width: 600px;
        }

        .register-intro {
            display: none;
        }

        .register-form-section {
            padding: 40px 30px;
        }

    }

    @@media (max-width: 480px) {

        .register-page {
            padding: 20px 10px;
        }

        .register-form-section {
            padding: 30px 20px;
        }

        .register-header h1 {
            font-size: 26px;
        }

    }

</style>


<div class="register-page">

    <div class="register-wrapper">


        <!-- =========================================
             LEFT - GIỚI THIỆU
        ========================================== -->

        <div class="register-intro">

            <div class="register-logo">

                <div class="register-logo-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <span>LMS Academy</span>

            </div>


            <div class="register-intro-content">

                <h2>
                    Bắt đầu hành trình<br />
                    học tập của bạn
                </h2>

                <p>
                    Tạo tài khoản miễn phí và khám phá
                    kho khóa học lập trình từ cơ bản
                    đến chuyên nghiệp.
                </p>


                <div class="register-benefit">

                    <div class="register-benefit-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <span>
                        Hàng trăm khóa học chất lượng
                    </span>

                </div>


                <div class="register-benefit">

                    <div class="register-benefit-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <span>
                        Học tập mọi lúc, mọi nơi
                    </span>

                </div>


                <div class="register-benefit">

                    <div class="register-benefit-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <span>
                        Theo dõi tiến trình học tập
                    </span>

                </div>


                <div class="register-benefit">

                    <div class="register-benefit-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <span>
                        Chứng chỉ sau khi hoàn thành
                    </span>

                </div>

            </div>

        </div>


        <!-- =========================================
             RIGHT - FORM ĐĂNG KÝ
        ========================================== -->

        <div class="register-form-section">


            <div class="register-header">

                <h1>
                    Tạo tài khoản
                </h1>

                <p>
                    Điền thông tin bên dưới để bắt đầu học tập
                </p>

            </div>


            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">


                <!-- VALIDATION -->

                <div asp-validation-summary="ModelOnly"
                     class="register-validation"
                     role="alert">
                </div>


                <!-- HỌ VÀ TÊN -->

                <div class="register-field">

                    <label class="register-label">
                        Họ và tên
                    </label>

                    <div class="register-input-wrapper">

                        <i class="bi bi-person register-input-icon"></i>

                        <input asp-for="Input.FullName"
                               class="register-input"
                               placeholder="Nhập họ và tên"
                               aria-required="true" />

                    </div>

                    <span asp-validation-for="Input.FullName"
                          class="register-error">
                    </span>

                </div>


                <!-- EMAIL -->

                <div class="register-field">

                    <label class="register-label">
                        Email
                    </label>

                    <div class="register-input-wrapper">

                        <i class="bi bi-envelope register-input-icon"></i>

                        <input asp-for="Input.Email"
                               class="register-input"
                               autocomplete="username"
                               placeholder="example@gmail.com"
                               aria-required="true" />

                    </div>

                    <span asp-validation-for="Input.Email"
                          class="register-error">
                    </span>

                </div>


                <!-- MẬT KHẨU -->

                <div class="register-field">

                    <label class="register-label">
                        Mật khẩu
                    </label>

                    <div class="register-input-wrapper">

                        <i class="bi bi-lock register-input-icon"></i>

                        <input asp-for="Input.Password"
                               class="register-input"
                               autocomplete="new-password"
                               placeholder="Nhập mật khẩu"
                               aria-required="true" />

                    </div>

                    <span asp-validation-for="Input.Password"
                          class="register-error">
                    </span>

                </div>


                <!-- XÁC NHẬN MẬT KHẨU -->

                <div class="register-field">

                    <label class="register-label">
                        Xác nhận mật khẩu
                    </label>

                    <div class="register-input-wrapper">

                        <i class="bi bi-shield-lock register-input-icon"></i>

                        <input asp-for="Input.ConfirmPassword"
                               class="register-input"
                               autocomplete="new-password"
                               placeholder="Nhập lại mật khẩu"
                               aria-required="true" />

                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="register-error">
                    </span>

                </div>


                <!-- VAI TRÒ -->

                <div class="register-field">

                    <label class="register-label">
                        Vai trò
                    </label>

                    <div class="register-input-wrapper">

                        <i class="bi bi-person-badge register-input-icon"></i>

                        <select asp-for="Input.Role"
                                asp-items="@Model.Input.RoleList"
                                class="register-select">

                            <option disabled selected>
                                -- Chọn vai trò --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="Input.Role"
                          class="register-error">
                    </span>

                </div>


                <!-- BUTTON -->

                <button id="registerSubmit"
                        type="submit"
                        class="register-button">

                    <i class="bi bi-person-plus-fill me-2"></i>

                    Tạo tài khoản

                </button>


                <!-- LOGIN -->

                <div class="register-login">

                    Đã có tài khoản?

                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl">

                        Đăng nhập ngay

                    </a>

                </div>


                <!-- EXTERNAL LOGIN -->

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {

                    <div class="external-login">

                        <div class="external-login-title">
                            Hoặc đăng ký bằng
                        </div>


                        <form id="external-account"
                              asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post">

                            @foreach (var provider in Model.ExternalLogins!)
                            {

                                <button type="submit"
                                        name="provider"
                                        value="@provider.Name">

                                    <i class="bi bi-google me-2"></i>

                                    @provider.DisplayName

                                </button>

                            }

                        </form>

                    </div>

                }

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}