@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="row">
    <div class="col-12 col-lg-6">
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="h5 mb-3">Đổi mật khẩu</h4>
                <partial name="_StatusMessage" for="StatusMessage" />

                <form id="change-password-form" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                    <div class="mb-3 position-relative">
                        <div class="form-floating">
                            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu cũ" />
                            <label asp-for="Input.OldPassword" class="form-label">Mật khẩu hiện tại</label>
                        </div>
                    </div>

                    <div class="mb-3 position-relative">
                        <div class="form-floating">
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu mới" id="newPassword" />
                            <label asp-for="Input.NewPassword" class="form-label">Mật khẩu mới</label>
                        </div>
                        <div class="form-text small text-muted mt-1">Sử dụng ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và số.</div>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu" />
                            <label asp-for="Input.ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-muted small">Lưu ý: Sau khi đổi mật khẩu, bạn sẽ cần đăng nhập lại trên các thiết bị mới nếu có cấu hình session.</div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
