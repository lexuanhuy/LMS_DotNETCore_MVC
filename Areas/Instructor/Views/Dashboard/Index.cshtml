@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Instructor/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Dashboard
            </h1>

            <p class="text-muted mb-0">
                Tổng quan hoạt động của hệ thống LMS (Instructor)
            </p>
        </div>

        <div class="text-muted">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Now.ToString("dd/MM/yyyy")
        </div>

    </div>

    <!-- STATISTICS -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Tổng khóa học
                            </p>
                            <h2 class="fw-bold mb-0">
                                @(ViewBag.TotalCourses ?? "—")
                            </h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-book-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        12% so với tháng trước
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Học viên
                            </p>
                            <h2 class="fw-bold mb-0">
                                @(ViewBag.TotalStudents ?? "—")
                            </h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        8.5% so với tháng trước
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Bài học
                            </p>
                            <h2 class="fw-bold mb-0">
                                @(ViewBag.TotalLessons ?? "—")
                            </h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                            <i class="bi bi-journal-bookmark-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        5.2% so với tháng trước
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Doanh thu
                            </p>
                            <h2 class="fw-bold mb-0">
                                @(ViewBag.Revenue ?? "—")
                            </h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-success">
                        <i class="bi bi-arrow-up"></i>
                        15.8% so với tháng trước
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- CONTENT -->
    <div class="row g-4">

        <div class="col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Tổng quan khóa học
                            </h5>
                            <p class="text-muted small mb-0">
                                Thống kê khóa học của giảng viên
                            </p>
                        </div>
                        <a asp-area="Instructor"
                           asp-controller="Courses"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm">
                            Xem khóa học
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Lập trình Web</span>
                            <strong>80%</strong>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar" style="width:80%;"></div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Lập trình C#</span>
                            <strong>65%</strong>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-success" style="width:65%;"></div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>JavaScript</span>
                            <strong>55%</strong>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-warning" style="width:55%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-1">
                        Thao tác nhanh
                    </h5>
                    <p class="text-muted small mb-0">
                        Quản lý giảng viên
                    </p>
                </div>

                <div class="card-body p-4">
                    <div class="d-grid gap-3">
                        <a asp-area="Instructor"
                           asp-controller="Courses"
                           asp-action="Create"
                           class="btn btn-primary text-start p-3">
                            <i class="bi bi-plus-circle me-2"></i>
                            Thêm khóa học
                        </a>

                        <a asp-area="Instructor"
                           asp-controller="Courses"
                           asp-action="Index"
                           class="btn btn-outline-primary text-start p-3">
                            <i class="bi bi-book me-2"></i>
                            Quản lý khóa học
                        </a>

                        <a href="#"
                           class="btn btn-outline-secondary text-start p-3">
                            <i class="bi bi-people me-2"></i>
                            Quản lý học viên
                        </a>

                        <a href="#"
                           class="btn btn-outline-secondary text-start p-3">
                            <i class="bi bi-person-workspace me-2"></i>
                            Quản lý giảng viên
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>