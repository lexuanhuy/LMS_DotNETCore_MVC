@model IEnumerable<LMS_DotNETCore_MVC.Models.Course>

@{
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h4 mb-0">Quản lý khóa học</h1>

        <a asp-area="Instructor" asp-controller="Courses" asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-2" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 1a.5.5 0 0 1 .5.5V7.5H14a.5.5 0 0 1 0 1H8.5V14a.5.5 0 0 1-1 0V8.5H2a.5.5 0 0 1 0-1h5.5V1.5A.5.5 0 0 1 8 1z" />
            </svg>
            Thêm khóa học mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:110px;">Ảnh</th>
                            <th>Tên khóa học</th>
                            <th style="width:140px;">Giá</th>
                            <th style="width:150px;">Số lượng bài học</th>
                            <th style="width:260px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(item.ImageUrl ?? Url.Content("~/images/course-placeholder-sm.jpg"))"
                                             alt="@item.Title"
                                             class="img-fluid rounded"
                                             style="width:100px;height:60px;object-fit:cover;">
                                    </td>

                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        @* <div class="small text-muted">@item.Description</div> *@
                                    </td>

                                    <td class="align-middle">
                                        @if (@item.Price > 0)
                                        {
                                            <div class="fw-medium text-primary">@item.Price</div>
                                        }
                                        else
                                        {
                                            <div class="badge bg-secondary">Miễn phí</div>
                                        }
                                    </td>

                                    <td class="align-middle">
                                        <span class="badge bg-secondary">@item.Lessons?.Count</span>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-area="Instructor" asp-controller="Courses" asp-action="Update" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">Sửa</a>

                                            <form asp-area="Instructor" asp-controller="Courses" asp-action="Delete" asp-route-id="@item.Id"
                                                  method="post" onsubmit="return confirm('Bạn có chắc muốn xóa khóa học?');" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>

                                            <a asp-area="Instructor" asp-controller="Lessons" asp-action="Index" asp-route-courseId="@item.Id"
                                               class="btn btn-sm btn-outline-primary">Quản lý bài học</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Chưa có khóa học nào. Nhấn "Thêm khóa học mới" để tạo.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>