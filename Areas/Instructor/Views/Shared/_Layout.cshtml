<!DOCTYPE html>
<html lang="vi">

<head>

	<meta charset="utf-8" />

	<meta name="viewport"
		  content="width=device-width, initial-scale=1.0" />

	<title>@ViewData["Title"] - LMS Admin</title>

	<link rel="stylesheet"
		  href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<link rel="stylesheet"
		  href="~/css/admin.css" />

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

	<style>
		.admin-user .navbar-nav {
			flex-direction: row;
		}
	</style>

</head>

<body class="admin-body">

	<!-- SIDEBAR -->

	<aside class="admin-sidebar">

		<!-- LOGO -->

		<div class="admin-logo">

			<div class="admin-logo-icon">
				<i class="bi bi-mortarboard-fill"></i>
			</div>

			<div>
				<div class="admin-logo-title">
					LMS
				</div>

				<div class="admin-logo-subtitle">
					ADMIN PANEL
				</div>
			</div>

		</div>


		<!-- MENU -->

		<nav class="admin-menu">

			<div class="admin-menu-label">
				QUẢN LÝ
			</div>


			<!-- Dashboard -->

			<a asp-area="Instructor"
			   asp-controller="Dashboard"
			   asp-action="Index"
			   class="admin-menu-item">

				<i class="bi bi-grid-1x2-fill"></i>

				<span>
					Dashboard
				</span>

			</a>


			<!-- Courses -->

			<a href="/Instructor/Courses"
			   class="admin-menu-item">

				<i class="bi bi-book-fill"></i>

				<span>
					Khóa học
				</span>

			</a>


			<!-- Users -->

			@* <a href="#"
			   class="admin-menu-item">

				<i class="bi bi-people-fill"></i>

				<span>
					Người dùng
				</span>

			</a> *@

		</nav>


		<!-- BOTTOM -->

		<div class="admin-sidebar-bottom">

			<a href="/"
			   class="admin-menu-item">

				<i class="bi bi-house-fill"></i>

				<span>
					Về trang chủ
				</span>

			</a>

			<form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
				<button type="submit" class="border-0 bg-transparent w-100">
					<a href="#"
					   class="admin-menu-item admin-logout">

						<i class="bi bi-box-arrow-right"></i>

						<span>
							Đăng xuất
						</span>

					</a>
				</button>
			</form>

			

		</div>

	</aside>


	<!-- MAIN -->

	<main class="admin-main">


		<!-- TOPBAR -->

		<header class="admin-topbar">

			<div>

				<button id="sidebarToggle"
						class="admin-mobile-toggle">

					<i class="bi bi-list"></i>

				</button>

			</div>


			<div class="admin-user">
				<partial name="_LoginPartial" />
			</div>

		</header>


		<!-- CONTENT -->

		<div class="admin-content">

			@RenderBody()

		</div>


	</main>


	<script src="~/lib/jquery/dist/jquery.min.js"></script>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


	<script>

		const toggle =
			document.getElementById("sidebarToggle");

		const sidebar =
			document.querySelector(".admin-sidebar");

		toggle?.addEventListener("click", function () {

			sidebar.classList.toggle("show");

		});


		document
			.querySelectorAll(".admin-menu-item")
			.forEach(function (item) {

				const currentPath =
					window.location.pathname.toLowerCase();

				const href =
					item.getAttribute("href");

				if (
					href &&
					href !== "#" &&
					currentPath === href.toLowerCase()
				) {
					item.classList.add("active");
				}

			});

	</script>

	@await RenderSectionAsync("Scripts",required: false)

</body>

</html>