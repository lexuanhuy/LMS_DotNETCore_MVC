@model IEnumerable<LMS_DotNETCore_MVC.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục Khóa học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Quản lý Danh mục Khóa học</h2>
        <p class="text-muted mb-0">Thêm, chỉnh sửa và sắp xếp các danh mục lĩnh vực học tập</p>
    </div>
    <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Biểu tượng</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Thứ tự</th>
                        <th>Số khóa học</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <td class="ps-4 fs-4">@cat.IconClass</td>
                                <td class="fw-bold">@cat.Name</td>
                                <td class="text-muted small">@cat.Description</td>
                                <td><span class="badge bg-secondary rounded-pill">#@cat.DisplayOrder</span></td>
                                <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3">@cat.Courses.Count khóa học</span></td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary rounded-circle me-1" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal-@cat.Id">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            <!-- Modal Edit -->
                            <div class="modal fade" id="editModal-@cat.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <form asp-action="Edit" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@cat.Id" />
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold">Chỉnh sửa Danh mục</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Tên danh mục</label>
                                                    <input type="text" name="Name" class="form-control rounded-3" value="@cat.Name" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Biểu tượng (Emoji / Class)</label>
                                                    <input type="text" name="IconClass" class="form-control rounded-3" value="@cat.IconClass" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Thứ tự hiển thị</label>
                                                    <input type="number" name="DisplayOrder" class="form-control rounded-3" value="@cat.DisplayOrder" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Mô tả</label>
                                                    <textarea name="Description" class="form-control rounded-3" rows="3">@cat.Description</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu thay đổi</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Create -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Thêm Danh mục Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên danh mục</label>
                        <input type="text" name="Name" class="form-control rounded-3" placeholder="Nhập tên danh mục..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Biểu tượng (Emoji / Class)</label>
                        <input type="text" name="IconClass" class="form-control rounded-3" placeholder="vd: 💻 hoặc bi bi-code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thứ tự hiển thị</label>
                        <input type="number" name="DisplayOrder" class="form-control rounded-3" value="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        <textarea name="Description" class="form-control rounded-3" rows="3" placeholder="Mô tả ngắn gọn..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Tạo mới</button>
                </div>
            </form>
        </div>
    </div>
</div>
