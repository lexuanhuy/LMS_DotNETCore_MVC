@model IEnumerable<LMS_DotNETCore_MVC.Data.ApplicationUser>

@{
    ViewData["Title"] = "Quản lý Học viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var enrollmentCounts = ViewBag.EnrollmentCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0">Quản lý Học viên</h1>
            <p class="text-muted mb-0 small">Quản lý toàn bộ tài khoản học viên đã đăng ký</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
                @Model.Count() học viên
            </span>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- SEARCH BAR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-0 bg-light"
                           placeholder="Tìm theo họ tên hoặc email..." />
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold text-nowrap">Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Xóa lọc</a>
                }
            </form>
        </div>
    </div>

    <!-- STUDENTS TABLE -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="px-4 py-3 fw-semibold text-muted">Học viên</th>
                        <th class="py-3 fw-semibold text-muted">Email</th>
                        <th class="py-3 fw-semibold text-muted text-center">Khoá học đã đăng ký</th>
                        <th class="py-3 fw-semibold text-muted text-center">Trạng thái</th>
                        <th class="py-3 fw-semibold text-muted">Ngày tạo</th>
                        <th class="py-3 fw-semibold text-muted text-end px-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            bool isLocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                            enrollmentCounts.TryGetValue(user.Id, out int enrolled);

                            <tr>
                                <!-- Avatar + Name -->
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(user.AvatarPath))
                                        {
                                            <img src="@user.AvatarPath" class="rounded-circle shadow-sm"
                                                 style="width:42px; height:42px; object-fit:cover;"
                                                 onerror="this.src='/images/default-avatar.png';" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                                 style="width:42px; height:42px; background: linear-gradient(135deg, #667eea, #764ba2); font-size:16px;">
                                                @(user.FullName?.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold text-dark">@(user.FullName ?? "Chưa đặt tên")</div>
                                            <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- Email -->
                                <td class="py-3">
                                    <span class="text-secondary">@user.Email</span>
                                </td>

                                <!-- Enrolled Count -->
                                <td class="py-3 text-center">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold">
                                        @enrolled khóa học
                                    </span>
                                </td>

                                <!-- Status -->
                                <td class="py-3 text-center">
                                    @if (isLocked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-lock-fill me-1"></i> Đã khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                        </span>
                                    }
                                </td>

                                <!-- Created -->
                                <td class="py-3">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @user.CreatedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </td>

                                <!-- Actions -->
                                <td class="py-3 px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <!-- View Progress -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info rounded-pill px-3"
                                                onclick="loadUserProgress('@user.Id', '@(user.FullName ?? user.Email)')"
                                                data-bs-toggle="modal" data-bs-target="#progressModal">
                                            <i class="bi bi-bar-chart-fill me-1"></i> Tiến độ
                                        </button>

                                        <!-- Lock/Unlock -->
                                        <form asp-action="ToggleLock" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm @(isLocked ? "btn-outline-success" : "btn-outline-warning") rounded-pill px-3"
                                                    onclick="return confirm('@(isLocked ? "Xác nhận mở khóa tài khoản " : "Xác nhận khóa tài khoản ")@user.Email?')">
                                                <i class="bi @(isLocked ? "bi-unlock-fill" : "bi-lock-fill") me-1"></i>
                                                @(isLocked ? "Mở khóa" : "Khóa")
                                            </button>
                                        </form>

                                        <!-- Reset Password -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                onclick="openResetPassword('@user.Id', '@user.Email')"
                                                data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
                                            <i class="bi bi-key-fill me-1"></i> Đặt lại MK
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people display-4 d-block mb-2"></i>
                                Không tìm thấy học viên nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PROGRESS MODAL -->
<div class="modal fade" id="progressModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="progressModalTitle">Tiến độ học tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2" id="progressModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2 text-muted small">Đang tải dữ liệu...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RESET PASSWORD MODAL -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Đặt lại mật khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" id="resetPasswordUserId" />
                    <div class="alert alert-warning rounded-3 small py-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Đặt lại mật khẩu cho: <strong id="resetPasswordUserEmail"></strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu mới</label>
                        <input type="password" name="newPassword" class="form-control rounded-3"
                               placeholder="Tối thiểu 6 ký tự, có chữ HOA và ký tự đặc biệt" required minlength="6" />
                        <div class="form-text">Yêu cầu: ít nhất 6 ký tự, bao gồm chữ hoa, chữ số và ký tự đặc biệt.</div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                        <i class="bi bi-key-fill me-1"></i> Đặt lại mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetPassword(userId, email) {
            document.getElementById('resetPasswordUserId').value = userId;
            document.getElementById('resetPasswordUserEmail').textContent = email;
        }

        function loadUserProgress(userId, fullName) {
            const title = document.getElementById('progressModalTitle');
            const body = document.getElementById('progressModalBody');
            title.textContent = 'Tiến độ học tập — ' + fullName;
            body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-muted small">Đang tải dữ liệu...</div></div>';

            fetch(`/Admin/Users/GetUserProgress/${userId}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.courses || data.courses.length === 0) {
                        body.innerHTML = `
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-journal-x display-4 d-block mb-2"></i>
                                Học viên này chưa đăng ký khóa học nào.
                            </div>`;
                        return;
                    }

                    let html = `
                        <div class="mb-3 p-3 bg-light rounded-3">
                            <div class="d-flex gap-3 flex-wrap">
                                <div><i class="bi bi-person-circle text-primary me-1"></i><strong>${data.fullName}</strong></div>
                                <div><i class="bi bi-envelope text-muted me-1"></i>${data.email}</div>
                                <div><i class="bi bi-calendar3 text-muted me-1"></i>Ngày tạo: ${data.createdAt}</div>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-3">`;

                    data.courses.forEach(c => {
                        const pct = c.percentage;
                        const color = pct >= 100 ? 'success' : pct >= 50 ? 'primary' : 'warning';
                        html += `
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-dark">${c.courseTitle}</span>
                                    <span class="badge bg-${color}-subtle text-${color} rounded-pill fw-bold">${pct}%</span>
                                </div>
                                <div class="text-muted small mb-2">
                                    <i class="bi bi-book me-1"></i> ${c.lessonCount} bài học &bull;
                                    <i class="bi bi-calendar3 ms-1 me-1"></i> Đăng ký: ${c.enrolledAt}
                                </div>
                                <div class="progress rounded-pill" style="height: 8px;">
                                    <div class="progress-bar bg-${color}" style="width: ${pct}%;" role="progressbar"></div>
                                </div>
                            </div>`;
                    });
                    html += '</div>';
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = '<div class="alert alert-danger rounded-3">Không thể tải dữ liệu. Vui lòng thử lại.</div>';
                });
        }
    </script>
}
