@model IEnumerable<LMS_DotNETCore_MVC.Models.Enrollment>
@{
    ViewData["Title"] = "Dashboard Quản trị";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-2">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tổng quan Hệ thống LMS</h2>
            <p class="text-muted mb-0">Báo cáo trực quan dữ liệu hệ thống, học viên và khóa học</p>
        </div>
        <div class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
            <i class="bi bi-calendar3 me-2 text-primary"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </div>
    </div>

    <!-- METRICS CARDS -->
    <div class="row g-4 mb-4">
        <!-- COURSES -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold mb-1">Tổng số Khóa học</p>
                            <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalCourses</h2>
                        </div>
                        <div class="bg-primary-subtle text-primary rounded-4 p-3 fs-3">
                            📚
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STUDENTS -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold mb-1">Tổng số Học viên</p>
                            <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalStudents</h2>
                        </div>
                        <div class="bg-success-subtle text-success rounded-4 p-3 fs-3">
                            🎓
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- INSTRUCTORS -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold mb-1">Giảng viên</p>
                            <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalInstructors</h2>
                        </div>
                        <div class="bg-warning-subtle text-warning rounded-4 p-3 fs-3">
                            👨‍🏫
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ENROLLMENTS -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold mb-1">Lượt đăng ký học</p>
                            <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalEnrollments</h2>
                        </div>
                        <div class="bg-info-subtle text-info rounded-4 p-3 fs-3">
                            📝
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RECENT ENROLLMENTS TABLE -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Lượt đăng ký khóa học mới nhất</h5>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">Quản lý khóa học</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Học viên</th>
                            <th>Email</th>
                            <th>Khóa học đăng ký</th>
                            <th>Ngày đăng ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@(item.Student?.FullName ?? "Học viên")</td>
                                    <td class="text-muted">@(item.Student?.Email ?? "N/A")</td>
                                    <td class="text-primary fw-semibold">@(item.Course?.Title ?? "N/A")</td>
                                    <td class="text-muted">@item.EnrollDate.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Chưa có lượt đăng ký nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>