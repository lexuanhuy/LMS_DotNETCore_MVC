@model IEnumerable<LMS_DotNETCore_MVC.Models.Course>

@{
    ViewData["Title"] = "Quản lý khóa học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var instructors = ViewBag.Instructors
        as IEnumerable<LMS_DotNETCore_MVC.Data.ApplicationUser>;
    var categories = ViewBag.Categories
        as IEnumerable<LMS_DotNETCore_MVC.Models.Category>;
}

<div class="container-fluid">

    <!-- ========================= -->
    <!-- PAGE HEADER -->
    <!-- ========================= -->

    <div class="admin-page-header mb-4">

        <div>
            <h1 class="admin-page-title">
                Quản lý khóa học
            </h1>

            <p class="admin-page-description">
                Quản lý, thêm, sửa và xóa khóa học trên hệ thống LMS
            </p>
        </div>

        <button type="button"
                class="admin-btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createCourseModal">

            <i class="bi bi-plus-lg"></i>

            Thêm khóa học

        </button>

    </div>


    <!-- ========================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================= -->
    <!-- STATISTICS -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <!-- TOTAL -->

        <div class="col-xl-4 col-md-6">

            <div class="admin-stat-card">

                <div class="admin-stat-content">

                    <div>

                        <div class="admin-stat-label">
                            Tổng khóa học
                        </div>

                        <h2 class="admin-stat-number">
                            @Model.Count()
                        </h2>

                    </div>

                    <div class="admin-stat-icon admin-stat-blue">
                        <i class="bi bi-book-fill text-primary"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- FREE -->

        <div class="col-xl-4 col-md-6">

            <div class="admin-stat-card">

                <div class="admin-stat-content">

                    <div>

                        <div class="admin-stat-label">
                            Khóa học miễn phí
                        </div>

                        <h2 class="admin-stat-number">
                            @Model.Count(c => c.Price == null || c.Price == 0)
                        </h2>

                    </div>

                    <div class="admin-stat-icon admin-stat-green">
                        <i class="bi bi-gift-fill text-success"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- PAID -->

        <div class="col-xl-4 col-md-6">

            <div class="admin-stat-card">

                <div class="admin-stat-content">

                    <div>

                        <div class="admin-stat-label">
                            Khóa học trả phí
                        </div>

                        <h2 class="admin-stat-number">
                            @Model.Count(c => c.Price > 0)
                        </h2>

                    </div>

                    <div class="admin-stat-icon admin-stat-orange">
                        <i class="bi bi-currency-dollar text-warning"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- COURSE TABLE -->
    <!-- ========================= -->

    <div class="admin-table-card">

        <!-- TABLE HEADER -->

        <div class="admin-table-header">

            <div>

                <h3 class="admin-table-title mb-1">
                    Danh sách khóa học
                </h3>

                <small class="text-muted">
                    @Model.Count() khóa học
                </small>

            </div>


            <!-- SEARCH -->

            <div class="admin-search">

                <i class="bi bi-search admin-search-icon"></i>

                <input type="text"
                       id="courseSearch"
                       class="form-control"
                       placeholder="Tìm kiếm khóa học..." />

            </div>

        </div>


        <!-- TABLE -->

        <div class="table-responsive">

            <table class="admin-course-table">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Hình ảnh</th>

                        <th>Khóa học</th>

                        <th>Giảng viên</th>

                        <th>Giá</th>

                        <th>Ngày tạo</th>

                        <th class="text-center">
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <tbody id="courseTable">

                    @if (Model.Any())
                    {
                        foreach (var course in Model)
                        {
                            <tr class="course-row">

                                <!-- ID -->

                                <td>

                                    <strong>
                                        #@course.Id
                                    </strong>

                                </td>


                                <!-- IMAGE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(course.ImageUrl))
                                    {
                                        <img src="@course.ImageUrl"
                                             class="admin-course-image"
                                             alt="@course.Title"
                                             onerror="this.style.display='none';" />
                                    }
                                    else
                                    {
                                        <div class="admin-course-image d-flex align-items-center justify-content-center bg-light">

                                            <i class="bi bi-image text-muted fs-4"></i>

                                        </div>
                                    }

                                </td>


                                <!-- TITLE -->

                                <td>

                                    <div class="admin-course-name">
                                        @course.Title
                                    </div>

                                    <div class="text-muted small mt-1">

                                        @{
                                            var shortDescription =
                                                course.Description ?? "";

                                            if (shortDescription.Length > 80)
                                            {
                                                shortDescription =
                                                    shortDescription.Substring(0, 80)
                                                    + "...";
                                            }
                                        }

                                        @shortDescription

                                    </div>

                                </td>


                                <!-- INSTRUCTOR -->

                                <td>

                                    @if (course.Instructor != null)
                                    {
                                        <span class="admin-course-instructor">

                                            <i class="bi bi-person-fill me-1"></i>

                                            @course.Instructor.FullName

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa có
                                        </span>
                                    }

                                </td>


                                <!-- PRICE -->

                                <td>

                                    @if (course.Price.HasValue &&
                                         course.Price.Value > 0)
                                    {
                                        <span class="admin-price">

                                            @course.Price.Value.ToString("N0") ₫

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-free">
                                            Miễn phí
                                        </span>
                                    }

                                </td>


                                <!-- CREATED -->

                                <td>

                                    <span class="text-muted small">

                                        @course.CreatedAt.ToString("dd/MM/yyyy")

                                    </span>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="admin-actions">

                                        <!-- VIEW -->

                                        <button type="button"
                                                class="admin-action-btn admin-action-view"
                                                title="Xem mô tả"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detailsCourseModal"
                                                data-id="@course.Id"
                                                data-title="@course.Title"
                                                data-description="@course.Description"
                                                data-price="@(course.Price.HasValue && course.Price.Value > 0 ? course.Price.Value.ToString("N0") + " ₫" : "Miễn phí")"
                                                data-instructor="@(course.Instructor?.FullName ?? "Chưa có")"
                                                data-image="@course.ImageUrl">

                                            <i class="bi bi-eye-fill"></i>

                                        </button>


                                        <!-- EDIT -->

                                        <button type="button"
                                                class="admin-action-btn admin-action-edit"
                                                title="Sửa"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCourseModal"
                                                data-id="@course.Id"
                                                data-title="@course.Title"
                                                data-description="@course.Description"
                                                data-price="@course.Price"
                                                data-image="@course.ImageUrl"
                                                data-instructor="@course.InstructorId">

                                            <i class="bi bi-pencil-fill"></i>

                                        </button>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="admin-action-btn admin-action-delete"
                                                title="Xóa"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteCourseModal"
                                                data-id="@course.Id"
                                                data-title="@course.Title">

                                            <i class="bi bi-trash-fill"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7">

                                <div class="text-center py-5">

                                    <i class="bi bi-book display-3 text-muted"></i>

                                    <h5 class="mt-3">
                                        Chưa có khóa học
                                    </h5>

                                    <p class="text-muted">
                                        Hãy thêm khóa học đầu tiên.
                                    </p>

                                    <button type="button"
                                            class="btn btn-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#createCourseModal">

                                        <i class="bi bi-plus-lg me-1"></i>

                                        Thêm khóa học

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- MODAL: THÊM KHÓA HỌC -->
<!-- ===================================================== -->

<div class="modal fade"
     id="createCourseModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-plus-circle text-primary me-2"></i>

                        Thêm khóa học

                    </h5>

                    <small class="text-muted">
                        Tạo khóa học mới trên hệ thống
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-area="Admin"
                  asp-controller="Courses"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                    class="alert alert-danger">
                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <!-- TITLE -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Tên khóa học
                            </label>

                            <input name="Title"
                                   class="form-control"
                                   maxlength="200"
                                   required
                                   placeholder="Nhập tên khóa học..." />

                        </div>


                        <!-- INSTRUCTOR -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Giảng viên
                            </label>

                            <select name="InstructorId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Chọn giảng viên --
                                </option>

                                @if (instructors != null)
                                {
                                    foreach (var instructor in instructors)
                                    {
                                        <option value="@instructor.Id">
                                            @instructor.FullName
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- CATEGORY -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Danh mục
                            </label>

                            <select name="CategoryId"
                                    class="form-select">

                                <option value="">
                                    -- Chọn danh mục --
                                </option>

                                @if (categories != null)
                                {
                                    foreach (var category in categories)
                                    {
                                        <option value="@category.Id">
                                            @category.IconClass @category.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- PRICE -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Giá khóa học
                            </label>

                            <div class="input-group">

                                <input name="Price"
                                       type="number"
                                       class="form-control"
                                       min="0"
                                       step="1000"
                                       value="0"
                                       placeholder="0" />

                                <span class="input-group-text">
                                    ₫
                                </span>

                            </div>

                            <small class="text-muted">
                                Nhập 0 nếu miễn phí.
                            </small>

                        </div>


                        <!-- IMAGE -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                URL hình ảnh
                            </label>

                            <input name="ImageUrl"
                                   class="form-control"
                                   placeholder="/images/course.jpg hoặc https://..." />

                        </div>


                        <!-- DESCRIPTION -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Mô tả khóa học
                            </label>

                            <textarea name="Description"
                                      class="form-control"
                                      rows="6"
                                      required
                                      placeholder="Nhập mô tả chi tiết về khóa học..."></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>

                        Lưu khóa học

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- MODAL: SỬA KHÓA HỌC -->
<!-- ===================================================== -->

<div class="modal fade"
     id="editCourseModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-pencil-square text-warning me-2"></i>

                        Chỉnh sửa khóa học

                    </h5>

                    <small class="text-muted">
                        Cập nhật thông tin khóa học
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-area="Admin"
                  asp-controller="Courses"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="Id"
                       id="editCourseId" />


                <div class="modal-body">

                    <div class="row g-3">

                        <!-- TITLE -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Tên khóa học
                            </label>

                            <input type="text"
                                   name="Title"
                                   id="editCourseTitle"
                                   class="form-control"
                                   maxlength="200"
                                   required />

                        </div>


                        <!-- INSTRUCTOR -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Giảng viên
                            </label>

                            <select name="InstructorId"
                                    id="editCourseInstructor"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Chọn giảng viên --
                                </option>

                                @if (instructors != null)
                                {
                                    foreach (var instructor in instructors)
                                    {
                                        <option value="@instructor.Id">
                                            @instructor.FullName
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- PRICE -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Giá khóa học
                            </label>

                            <div class="input-group">

                                <input type="number"
                                       name="Price"
                                       id="editCoursePrice"
                                       class="form-control"
                                       min="0"
                                       step="1000" />

                                <span class="input-group-text">
                                    ₫
                                </span>

                            </div>

                        </div>


                        <!-- IMAGE -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                URL hình ảnh
                            </label>

                            <input type="text"
                                   name="ImageUrl"
                                   id="editCourseImage"
                                   class="form-control" />

                        </div>


                        <!-- DESCRIPTION -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Mô tả khóa học
                            </label>

                            <textarea name="Description"
                                      id="editCourseDescription"
                                      class="form-control"
                                      rows="6"
                                      required></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-save me-1"></i>

                        Lưu thay đổi

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- MODAL: XEM CHI TIẾT -->
<!-- ===================================================== -->

<div class="modal fade"
     id="detailsCourseModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">
                    <i class="bi bi-book-fill text-primary me-2"></i>
                    Thông tin khóa học
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <img id="detailsCourseImage"
                             src=""
                             class="img-fluid rounded shadow-sm w-100"
                             style="max-height:220px; object-fit:cover;"
                             alt="Course image" />

                    </div>


                    <div class="col-md-8">

                        <h3 id="detailsCourseTitle"
                            class="fw-bold mb-3">
                        </h3>


                        <div class="mb-3">

                            <strong>
                                <i class="bi bi-person-fill me-1"></i>
                                Giảng viên:
                            </strong>

                            <span id="detailsCourseInstructor">
                            </span>

                        </div>


                        <div class="mb-3">

                            <strong>
                                <i class="bi bi-cash-stack me-1"></i>
                                Giá:
                            </strong>

                            <span id="detailsCoursePrice"
                                  class="text-primary fw-bold">
                            </span>

                        </div>

                    </div>


                    <div class="col-12">

                        <hr />

                        <h5 class="fw-bold mb-3">
                            Mô tả khóa học
                        </h5>

                        <div id="detailsCourseDescription"
                             class="p-3 bg-light rounded"
                             style="white-space: pre-line;">
                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Đóng

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- MODAL: XÓA -->
<!-- ===================================================== -->

<div class="modal fade"
     id="deleteCourseModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold text-danger">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    Xóa khóa học

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-area="Admin"
                  asp-controller="Courses"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteCourseId" />


                <div class="modal-body text-center">

                    <div class="mb-3">

                        <i class="bi bi-trash3-fill text-danger"
                           style="font-size:50px;">
                        </i>

                    </div>

                    <p>
                        Bạn có chắc chắn muốn xóa khóa học:
                    </p>

                    <h5 id="deleteCourseTitle"
                        class="fw-bold">
                    </h5>

                    <p class="text-muted mb-0">
                        Hành động này không thể hoàn tác.
                    </p>

                </div>


                <div class="modal-footer justify-content-center">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash-fill me-1"></i>

                        Xóa khóa học

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

<script>

document.addEventListener("DOMContentLoaded", function () {

    // =================================================
    // TÌM KIẾM
    // =================================================

    const searchInput =
        document.getElementById("courseSearch");

    const rows =
        document.querySelectorAll(".course-row");

    searchInput?.addEventListener("input", function () {

        const keyword =
            this.value.toLowerCase().trim();

        rows.forEach(function (row) {

            const text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(keyword) ? "" : "none";

        });

    });


    // =================================================
    // MODAL SỬA
    // =================================================

    const editModal =
        document.getElementById("editCourseModal");

    editModal?.addEventListener("show.bs.modal", function (event) {

        const button =
            event.relatedTarget;

        document.getElementById("editCourseId").value =
            button.getAttribute("data-id");

        document.getElementById("editCourseTitle").value =
            button.getAttribute("data-title") || "";

        document.getElementById("editCourseDescription").value =
            button.getAttribute("data-description") || "";

        document.getElementById("editCoursePrice").value =
            button.getAttribute("data-price") || "";

        document.getElementById("editCourseImage").value =
            button.getAttribute("data-image") || "";

        document.getElementById("editCourseInstructor").value =
            button.getAttribute("data-instructor") || "";

    });


    // =================================================
    // MODAL XEM
    // =================================================

    const detailsModal =
        document.getElementById("detailsCourseModal");

    detailsModal?.addEventListener("show.bs.modal", function (event) {

        const button =
            event.relatedTarget;

        const title =
            button.getAttribute("data-title") || "";

        const description =
            button.getAttribute("data-description") || "";

        const instructor =
            button.getAttribute("data-instructor") || "Chưa có";

        const price =
            button.getAttribute("data-price") || "Miễn phí";

        const image =
            button.getAttribute("data-image") || "";

        document.getElementById("detailsCourseTitle").textContent =
            title;

        document.getElementById("detailsCourseDescription").textContent =
            description;

        document.getElementById("detailsCourseInstructor").textContent =
            instructor;

        document.getElementById("detailsCoursePrice").textContent =
            price;


        const imageElement =
            document.getElementById("detailsCourseImage");

        if (image) {

            imageElement.src = image;
            imageElement.style.display = "block";

        } else {

            imageElement.style.display = "none";

        }

    });


    // =================================================
    // MODAL XÓA
    // =================================================

    const deleteModal =
        document.getElementById("deleteCourseModal");

    deleteModal?.addEventListener("show.bs.modal", function (event) {

        const button =
            event.relatedTarget;

        document.getElementById("deleteCourseId").value =
            button.getAttribute("data-id");

        document.getElementById("deleteCourseTitle").textContent =
            button.getAttribute("data-title");

    });

});

</script>

}